{
    "$schema": "../Translations.schemas.jsonc",
    // Basic errors.
    "errors.invalid-guild-id": {
        "type": "BASIC",
        "text": "Looks like you're not in a guild. Please use this command in a guild."
    },
    "errors.invalid-role-id": {
        "type": "BASIC",
        "text": "Invalid role. Please select a valid role."
    },
    "errors.unknown-message.title": {
        "type": "BASIC",
        "text": "Unknown Message"
    },
    "errors.unknown-message.description": {
        "type": "BASIC",
        "text": "Looks like this message is not supported. Please contact the administrator."
    },
    "errors.unimplemented-component.title": {
        "type": "BASIC",
        "text": "Unimplemented Component"
    },
    "errors.unimplemented-component.description": {
        "type": "BASIC",
        "text": "Looks like, this component is not implemented yet. Let the developer (@oliverperzyk) know about it."
    },
    "errors.unavailable-command.title": {
        "type": "BASIC",
        "text": "Unavailable Command"
    },
    "errors.unavailable-command.description": {
        "type": "BASIC",
        "text": "You are not privileged to use this command here, sorry!"
    },
    "errors.unimplemented-command.title": {
        "type": "BASIC",
        "text": "Unimplemented Command"
    },
    "errors.unimplemented-command.description": {
        "type": "BASIC",
        "text": "Looks like, this command is not implemented yet. Let the developer (@oliverperzyk) know about it."
    },
    // Verification command.
    "commands.verification.name": {
        "type": "BASIC",
        "text": "verification"
    },
    "commands.verification.description": {
        "type": "BASIC",
        "text": "Allows to manage the verification system in the current guild."
    },
    // Verification settings subcommand.
    "commands.verification.settings.name": {
        "type": "BASIC",
        "text": "settings"
    },
    "commands.verification.settings.description": {
        "type": "BASIC",
        "text": "Allows to manage the verification settings in the current guild."
    },
    // Verification settings modal.
    "modal.verification.settings.title": {
        "type": "BASIC",
        "text": "Verification Settings"
    },
    "modal.verification.settings.not-configured": {
        "type": "BASIC",
        "text": "Verification settings have not been configured for this guild yet, by default verification is disabled, but you can change it below."
    },
    "modal.verification.settings.configure": {
        "type": "BASIC",
        "text": "Below you can configure the verification settings for this guild."
    },
    "modal.verification.settings.toggle-verification.label": {
        "type": "BASIC",
        "text": "Toggle Verification"
    },
    "modal.verification.settings.toggle-verification.description": {
        "type": "BASIC",
        "text": "Whether the verification is enabled or disabled."
    },
    "modal.verification.settings.role.label": {
        "type": "BASIC",
        "text": "Verification Role"
    },
    "modal.verification.settings.role.description": {
        "type": "BASIC",
        "text": "The role that will be assigned to the users who pass the verification."
    },
    "modal.verification.settings.role.placeholder": {
        "type": "BASIC",
        "text": "Select the role that will be assigned to the users who pass the verification."
    },
    "modal.verification.settings.no-changes": {
        "type": "BASIC",
        "text": "No changes have been made to the verification settings."
    },
    "modal.verification.settings.success": {
        "type": "BASIC",
        "text": "Verification settings have been successfully updated."
    },
    // Verification requests subcommand.
    "commands.verification.requests.name": {
        "type": "BASIC",
        "text": "requests"
    },
    "commands.verification.requests.description": {
        "type": "BASIC",
        "text": "Allows to manage the verification requests in the current guild."
    },
    "modal.verification.title": {
        "type": "BASIC",
        "text": "Verification"
    },
    "modal.verification.description": {
        "type": "BASIC",
        "text": "Please fill out the verification form to verify yourself on this server."
    },
    "modal.verification.calculation.title": {
        "type": "BASIC",
        "text": "Calculate the result."
    },
    "modal.verification.calculation.description": {
        "type": "BASIC",
        "text": "How much is {{ firstNumber }} + {{ secondNumber }}?"
    },
    "modal.verification.calculation.placeholder": {
        "type": "BASIC",
        "text": "Enter the result."
    },
    "modal.verification.reason.title": {
        "type": "BASIC",
        "text": "Why do you want to join this server?"
    },
    "modal.verification.reason.description": {
        "type": "BASIC",
        "text": "Describe yourself and tell why, you should be added to this server."
    },
    "modal.verification.reason.placeholder": {
        "type": "BASIC",
        "text": "Tell a little about yourself..."
    },
    "modal.verification.accept-verification.title": {
        "type": "BASIC",
        "text": "Accept guidelines and conditions"
    },
    "modal.verification.accept-verification.description": {
        "type": "BASIC",
        "text": "To become a member of this server, you need to accept the guidelines and conditions of the server."
    },
    "errors.verification.not-accepted": {
        "type": "BASIC",
        "text": "You need to accept the guidelines and conditions of the server, to verify yourself."
    },
    "errors.verification.already-requested": {
        "type": "BASIC",
        "text": "You cannot request verification again."
    },
    "errors.verification.invalid-result": {
        "type": "BASIC",
        "text": "Invalid result. Please try again later."
    },
    "modal.verification.message.success.title": {
        "type": "BASIC",
        "text": "Verification has been successfully submitted"
    },
    "modal.verification.message.success.description": {
        "type": "BASIC",
        "text": "Please wait for the administrator's response, you will receive a notification about the verification result in a private message from me (bot)."
    },
    // Verification message subcommand.
    "commands.verification.message.name": {
        "type": "BASIC",
        "text": "message"
    },
    "commands.verification.message.description": {
        "type": "BASIC",
        "text": "Sends the verification message in the current channel."
    },
    "verification.sidenote": {
        "type": "BASIC",
        "text": "You can translate all bot's messgaes by clicking the 🌐 button above."
    },
    "verification.interaction.verify": {
        "type": "BASIC",
        "text": "Verify"
    },
    "verification.interaction.translate": {
        "type": "BASIC",
        "text": "Translate"
    },
    "verification.interaction.other-servers": {
        "type": "BASIC",
        "text": "Other Servers"
    },
    "commands.verification.message.invalid-channel": {
        "type": "BASIC",
        "text": "Invalid channel. Please use a text channel to send the verification message."
    },
    "commands.verification.message.success": {
        "type": "BASIC",
        "text": "The verification message has been sent in this channel."
    },
    // Slowdown command.
    "commands.slowdown.name": {
        "type": "BASIC",
        "text": "slowdown"
    },
    "commands.slowdown.description": {
        "type": "BASIC",
        "text": "Sets the slowdown for the current channel."
    },
    "commands.slowdown.seconds.name": {
        "type": "BASIC",
        "text": "seconds"
    },
    "commands.slowdown.seconds.description": {
        "type": "BASIC",
        "text": "Seconds to slow down the users' messages."
    },
    "commands.slowdown.minutes.name": {
        "type": "BASIC",
        "text": "minutes"
    },
    "commands.slowdown.minutes.description": {
        "type": "BASIC",
        "text": "Minutes to slow down the users' messages."
    },
    "commands.slowdown.hours.name": {
        "type": "BASIC",
        "text": "hours"
    },
    "commands.slowdown.hours.description": {
        "type": "BASIC",
        "text": "Hours to slow down the users' messages."
    },
    "commands.slowdown.success": {
        "type": "BASIC",
        "text": "Slowdown has been successfully changed for this channel."
    },
    "commands.slowdown.channel.invalid": {
        "type": "BASIC",
        "text": "Invalid channel. Please use a text channel to set the slowdown."
    }
}
