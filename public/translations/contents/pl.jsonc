{
    "$schema": "../Translations.schemas.jsonc",
    // Basic errors.
    "errors.invalid-guild-id": {
        "type": "BASIC",
        "text": "Wygląda na to, że nie jesteś na żadnym serwerze. Proszę użyć tej komendy na serwerze."
    },
    "errors.invalid-role-id": {
        "type": "BASIC",
        "text": "Nieprawidłowa rola. Proszę wybrać prawidłową rolę."
    },
    "errors.unknown-message.title": {
        "type": "BASIC",
        "text": "Nieznana Wiadomość"
    },
    "errors.unknown-message.description": {
        "type": "BASIC",
        "text": "Wygląda na to, że nie jest to obsługiwana wiadomość. Proszę skontaktować się z administratorem."
    },
    // Verification command.
    "commands.verification.name": {
        "type": "BASIC",
        "text": "weryfikacja"
    },
    "commands.verification.description": {
        "type": "BASIC",
        "text": "Pozwala na zarządzanie systemem weryfikacji na bieżącym serwerze."
    },
    // Verification settings subcommand.
    "commands.verification.settings.name": {
        "type": "BASIC",
        "text": "ustawienia"
    },
    "commands.verification.settings.description": {
        "type": "BASIC",
        "text": "Pozwala na zarządzanie ustawieniami weryfikacji na bieżącym serwerze."
    },
    // Verification settings modal.
    "modal.verification.settings.title": {
        "type": "BASIC",
        "text": "Ustawienia Weryfikacji"
    },
    "modal.verification.settings.not-configured": {
        "type": "BASIC",
        "text": "Ustawienia weryfikacji nie zostały jeszcze skonfigurowane dla tego serwera, domyślnie weryfikacja jest wyłączona, ale możesz to zmienić poniżej."
    },
    "modal.verification.settings.configure": {
        "type": "BASIC",
        "text": "Poniżej możesz skonfigurować ustawienia weryfikacji dla tego serwera."
    },
    "modal.verification.settings.toggle-verification.label": {
        "type": "BASIC",
        "text": "Włącz/Wyłącz Weryfikację"
    },
    "modal.verification.settings.toggle-verification.description": {
        "type": "BASIC",
        "text": "Czy weryfikacja jest włączona czy wyłączona."
    },
    "modal.verification.settings.role.label": {
        "type": "BASIC",
        "text": "Rola Weryfikacji"
    },
    "modal.verification.settings.role.description": {
        "type": "BASIC",
        "text": "Rola, która zostanie przypisana do użytkowników, którzy przejdą weryfikację."
    },
    "modal.verification.settings.role.placeholder": {
        "type": "BASIC",
        "text": "Wybierz rolę, która zostanie przypisana do użytkowników, którzy przejdą weryfikację."
    },
    // Verification requests subcommand.
    "commands.verification.requests.name": {
        "type": "BASIC",
        "text": "żądania"
    },
    "commands.verification.requests.description": {
        "type": "BASIC",
        "text": "Pozwala na zarządzanie żądaniami weryfikacji na bieżącym serwerze."
    },
    "modal.verification.title": {
        "type": "BASIC",
        "text": "Weryfikacja"
    },
    "modal.verification.description": {
        "type": "BASIC",
        "text": "Proszę wypełnić formularz weryfikacji, aby zweryfikować się na tym serwerze."
    },
    "modal.verification.calculation.title": {
        "type": "BASIC",
        "text": "Oblicz wynik."
    },
    "modal.verification.calculation.description": {
        "type": "BASIC",
        "text": "Ile to jest {{ firstNumber }} + {{ secondNumber }}?"
    },
    "modal.verification.calculation.placeholder": {
        "type": "BASIC",
        "text": "Wpisz wynik."
    },
    "modal.verification.reason.title": {
        "type": "BASIC",
        "text": "Dlaczego chciałbyś dołączyć do tego serwera?"
    },
    "modal.verification.reason.description": {
        "type": "BASIC",
        "text": "Opisz siebie i powiedz dlaczego, powinieneś zostać dodany do tego serwera."
    },
    "modal.verification.reason.placeholder": {
        "type": "BASIC",
        "text": "Powiedz nieco o sobie..."
    },
    "modal.verification.accept-verification.title": {
        "type": "BASIC",
        "text": "Zaakceptuj zasady i warunki"
    },
    "modal.verification.accept-verification.description": {
        "type": "BASIC",
        "text": "Aby stać się członkiem tego serwera, musisz zaakceptować [zasady i warunki]({{ informationChannelLink }}) serwera."
    },
    "errors.verification.not-accepted": {
        "type": "BASIC",
        "text": "Musisz zaakceptować [zasady i warunki]({{ informationChannelLink }}) serwera, aby zweryfikować się."
    },
    "errors.verification.already-requested": {
        "type": "BASIC",
        "text": "Nie możesz złożyć kolejnego żądania weryfikacji."
    },
    "errors.verification.invalid-result": {
        "type": "BASIC",
        "text": "Nieprawidłowy wynik. Proszę spróbować ponownie później."
    },
    "modal.verification.message.success.title": {
        "type": "BASIC",
        "text": "Weryfikacja została pomyślnie złożona"
    },
    "modal.verification.message.success.description": {
        "type": "BASIC",
        "text": "Proszę poczekać na odpowiedź administratora, otrzymasz powiadomienie o wyniku weryfikacji w wiadomości prywatnej ode mnie (bota)."
    },
    // Verification message subcommand.
    "commands.verification.message.name": {
        "type": "BASIC",
        "text": "wiadomość"
    },
    "commands.verification.message.description": {
        "type": "BASIC",
        "text": "Wysyła wiadomość weryfikacji na bieżącym kanale."
    },
    "verification.sidenote": {
        "type": "BASIC",
        "text": "Możesz przetłumaczyć wszystkie wiadomości bota klikając przycisk 🌐 powyżej."
    },
    "verification.interaction.verify": {
        "type": "BASIC",
        "text": "Zweryfikuj się"
    },
    "verification.interaction.translate": {
        "type": "BASIC",
        "text": "Przetłumacz"
    },
    "verification.interaction.other-servers": {
        "type": "BASIC",
        "text": "Inne serwery"
    },
    "commands.verification.message.invalid-channel": {
        "type": "BASIC",
        "text": "Nieprawidłowy kanał. Proszę użyć kanału tekstowego do wysyłania wiadomości z możliwością weryfikacji."
    },
    "commands.verification.message.success": {
        "type": "BASIC",
        "text": "Wiadomość weryfikacji została wysłana na tym kanale."
    },
    // Slowdown command.
    "commands.slowdown.name": {
        "type": "BASIC",
        "text": "spowolnienie"
    },
    "commands.slowdown.description": {
        "type": "BASIC",
        "text": "Ustawia spowolnienie dla bieżącego kanału."
    },
    "commands.slowdown.seconds.name": {
        "type": "BASIC",
        "text": "sekundy"
    },
    "commands.slowdown.seconds.description": {
        "type": "BASIC",
        "text": "Sekundy do spowolnienia wiadomości użytkowników."
    },
    "commands.slowdown.minutes.name": {
        "type": "BASIC",
        "text": "minuty"
    },
    "commands.slowdown.minutes.description": {
        "type": "BASIC",
        "text": "Minuty do spowolnienia wiadomości użytkowników."
    },
    "commands.slowdown.hours.name": {
        "type": "BASIC",
        "text": "godziny"
    },
    "commands.slowdown.hours.description": {
        "type": "BASIC",
        "text": "Godziny do spowolnienia wiadomości użytkowników."
    },
    "commands.slowdown.success": {
        "type": "BASIC",
        "text": "Spowolnienie zostało pomyślnie zmienione dla tego kanału."
    },
    "commands.slowdown.channel.invalid": {
        "type": "BASIC",
        "text": "Nieprawidłowy kanał. Proszę użyć kanału tekstowego do ustawienia spowolnienia."
    }
}
