{
    "$schema": "../Translations.schemas.jsonc",
    // Basic errors.
    "errors.invalid-guild-id": {
        "type": "BASIC",
        "text": "Wygląda na to, że nie jesteś na żadnym serwerze. Proszę użyć tej komendy na serwerze."
    },
    "errors.invalid-role-id": {
        "type": "BASIC",
        "text": "Nieprawidłowa rola. Proszę wybrać prawidłową rolę."
    },
    // Verification command.
    "commands.verification.name": {
        "type": "BASIC",
        "text": "weryfikacja"
    },
    "commands.verification.description": {
        "type": "BASIC",
        "text": "Pozwala na zarządzanie systemem weryfikacji na bieżącym serwerze."
    },
    // Verification settings subcommand.
    "commands.verification.settings.name": {
        "type": "BASIC",
        "text": "ustawienia"
    },
    "commands.verification.settings.description": {
        "type": "BASIC",
        "text": "Pozwala na zarządzanie ustawieniami weryfikacji na bieżącym serwerze."
    },
    // Verification settings modal.
    "modal.verification.settings.title": {
        "type": "BASIC",
        "text": "Ustawienia Weryfikacji"
    },
    "modal.verification.settings.not-configured": {
        "type": "BASIC",
        "text": "Ustawienia weryfikacji nie zostały jeszcze skonfigurowane dla tego serwera, domyślnie weryfikacja jest wyłączona, ale możesz to zmienić poniżej."
    },
    "modal.verification.settings.configure": {
        "type": "BASIC",
        "text": "Poniżej możesz skonfigurować ustawienia weryfikacji dla tego serwera."
    },
    "modal.verification.settings.toggle-verification.label": {
        "type": "BASIC",
        "text": "Włącz/Wyłącz Weryfikację"
    },
    "modal.verification.settings.toggle-verification.description": {
        "type": "BASIC",
        "text": "Czy weryfikacja jest włączona czy wyłączona."
    },
    "modal.verification.settings.role.label": {
        "type": "BASIC",
        "text": "Rola Weryfikacji"
    },
    "modal.verification.settings.role.description": {
        "type": "BASIC",
        "text": "Rola, która zostanie przypisana do użytkowników, którzy przejdą weryfikację."
    },
    "modal.verification.settings.role.placeholder": {
        "type": "BASIC",
        "text": "Wybierz rolę, która zostanie przypisana do użytkowników, którzy przejdą weryfikację."
    },
    // Verification requests subcommand.
    "commands.verification.requests.name": {
        "type": "BASIC",
        "text": "żądania"
    },
    "commands.verification.requests.description": {
        "type": "BASIC",
        "text": "Pozwala na zarządzanie żądaniami weryfikacji na bieżącym serwerze."
    },
    // Verification message subcommand.
    "commands.verification.message.name": {
        "type": "BASIC",
        "text": "wiadomość"
    },
    "commands.verification.message.description": {
        "type": "BASIC",
        "text": "Wysyła wiadomość weryfikacji na bieżącym kanale."
    },
    // Slowdown command.
    "commands.slowdown.name": {
        "type": "BASIC",
        "text": "spowolnienie"
    },
    "commands.slowdown.description": {
        "type": "BASIC",
        "text": "Ustawia spowolnienie dla bieżącego kanału."
    },
    "commands.slowdown.seconds.name": {
        "type": "BASIC",
        "text": "sekundy"
    },
    "commands.slowdown.seconds.description": {
        "type": "BASIC",
        "text": "Sekundy do spowolnienia wiadomości użytkowników."
    },
    "commands.slowdown.minutes.name": {
        "type": "BASIC",
        "text": "minuty"
    },
    "commands.slowdown.minutes.description": {
        "type": "BASIC",
        "text": "Minuty do spowolnienia wiadomości użytkowników."
    },
    "commands.slowdown.hours.name": {
        "type": "BASIC",
        "text": "godziny"
    },
    "commands.slowdown.hours.description": {
        "type": "BASIC",
        "text": "Godziny do spowolnienia wiadomości użytkowników."
    },
    "commands.slowdown.success": {
        "type": "BASIC",
        "text": "Spowolnienie zostało pomyślnie zmienione dla tego kanału."
    },
    "commands.slowdown.channel.invalid": {
        "type": "BASIC",
        "text": "Nieprawidłowy kanał. Proszę użyć kanału tekstowego do ustawienia spowolnienia."
    }
}
